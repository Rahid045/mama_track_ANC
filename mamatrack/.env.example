# Production (Vercel): hosted PostgreSQL URL. Do not commit a real value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# The public deployment URL, used in SMS reschedule links.
BASE_URL=https://your-project.vercel.app
# Long random value used to protect Vercel's scheduled cron request.
CRON_SECRET=replace-with-a-long-random-secret
